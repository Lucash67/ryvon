# ── Development demo (local only) ─────────────────────────────────────────────
# Skip auth and use in-memory mock data. Never set "true" in production.
NEXT_PUBLIC_AUTH_DISABLED=true

# Optional explicit demo flag (local only; ignored in production)
# NEXT_PUBLIC_DEMO_MODE=true

# ── Production / real auth ────────────────────────────────────────────────────
# Omit NEXT_PUBLIC_AUTH_DISABLED or set to anything other than "true".
# Both Supabase vars are required when auth is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (seed script, never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Seed defaults (local `npm run seed`)
SEED_EMAIL=lucas@fitness-os.local
SEED_PASSWORD=fitnessos
SEED_NAME=Lucas
